# LLM provider — Gemini (free tier)
GEMINI_API_KEY=your_gemini_api_key_here
# Floating alias on purpose — a pinned version can be withdrawn for new keys
# and then every call 404s. Override only if you need a specific model.
GEMINI_MODEL=gemini-flash-lite-latest

# Database — Supabase (Postgres). Both values come from your Supabase project:
# Dashboard -> Project Settings -> API.
#   SUPABASE_URL: the "Project URL"
#   SUPABASE_KEY: the service_role key (server-side only — never ship it to a
#                 browser). The anon key will be rejected by the RLS policies
#                 in supabase/schema.sql.
# Run supabase/schema.sql in the SQL editor once before starting the API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Optional: path to tesseract binary if not on PATH (OCR fallback for scanned PDFs)
TESSERACT_CMD=

# Optional: how many batch items POST /api/ingest/batch processes at once.
# Default 4. This bounds parallelism (memory, open file handles) — it does NOT
# bound the request rate; that is NUVILOG_GEMINI_RPM below. A per-request
# `concurrency` form field overrides this.
NUVILOG_BATCH_CONCURRENCY=

# Optional: requests/minute ceiling for LLM calls during a batch. Default 15,
# matching Gemini's free-tier limit on Flash-Lite. Each batch item spends two
# calls, so a batch takes about (2 * items / this) minutes. Raise it on a paid
# key. Deliberately not settable per request — that would let one client spend
# the whole key's quota.
NUVILOG_GEMINI_RPM=
